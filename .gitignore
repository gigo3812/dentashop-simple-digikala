# ============================================
# 📦 wp-content
# ============================================

# 🎯 Uploads (حتماً ignore)
/wp-content/uploads/

# Cache
/wp-content/cache/
/wp-content/advanced-cache.php
/wp-content/wp-cache-config.php
/wp-content/wp-content-cache/

# Upgrade
/wp-content/upgrade/
/wp-content/backup-db/
/wp-content/backups/

# Languages (کش ترجمه‌ها)
/wp-content/languages/

# ============================================
# 🔌 Plugins
# ============================================

# 🎯 گزینه 1: همه افزونه‌ها ignore
# /wp-content/plugins/

# 🎯 گزینه 2: فقط افزونه‌های شخصی commit بشن
/wp-content/plugins/*
!/wp-content/plugins/gp-dentashop-plugin/

# ============================================
# 🎨 Themes
# ============================================

# 🎯 گزینه 1: همه قالب‌ها به جز قالب شخصی
/wp-content/themes/*
!/wp-content/themes/gp-dentashop/

# 🎯 گزینه 2: قالب GeneratePress هم نگه‌داری
# !/wp-content/themes/generatepress/

# ============================================
# 🎯 mu-plugins (اگه داری)
# ============================================
# /wp-content/mu-plugins/

# ============================================
# 🎬 Assets
# ============================================
/wp-content/themes/gp-dentashop/assets/dist/
/wp-content/themes/gp-dentashop/assets/build/
/wp-content/themes/gp-dentashop/assets/temp/
/wp-content/themes/gp-dentashop/assets/tmp/
/wp-content/themes/gp-dentashop/assets/cache/

